(load "../socket.carp")

(defn main []
  (match (TcpStream.connect "127.0.0.1" 8080)
    (Result.Error e) (IO.errorln &e)
    (Result.Success stream)
      (do
        (ignore (TcpStream.send-bytes &stream &[1b 2b 3b]))
        (match (TcpStream.read-bytes &stream)
          (Result.Success data) (println* &data)
          (Result.Error e) (IO.errorln &e))
        (TcpStream.close stream))))
