(load "../socket.carp")

(defn main []
  (match (TcpStream.connect "127.0.0.1" 8080)
    (Result.Error e) (IO.errorln &e)
    (Result.Success stream)
      (do
        (ignore (TcpStream.send &stream "hi from client"))
        (match (TcpStream.read &stream)
          (Result.Success msg) (IO.println &msg)
          (Result.Error e) (IO.errorln &e))
        (TcpStream.close stream))))
