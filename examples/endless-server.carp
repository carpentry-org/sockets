(load "../socket.carp")

(defn-do echo [client]
  (match (TcpStream.read client)
    (Result.Success msg) (IO.println &msg)
    (Result.Error e) (IO.errorln &e))
  (ignore (TcpStream.send client "hi")))

(defn main []
  (match (TcpListener.bind "127.0.0.1" 8080)
    (Result.Error e) (IO.errorln &e)
    (Result.Success listener)
      (do
        (TcpListener.while-accept &listener client (echo &client))
        (TcpListener.close listener))))
