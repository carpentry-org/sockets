(load "Test.carp")
(load "../socket.carp")
(use Test)

(relative-include "addr_helpers.h")

(defmodule AddrTest
  (register stream-families (Fn [] Int) "AddrTest_stream_MINUS_families_")
  (register occupy-first (Fn [] Int) "AddrTest_occupy_MINUS_first_")
  (register occupied-port (Fn [Int] Int) "AddrTest_occupied_MINUS_port_")
  (register release (Fn [Int] ()) "AddrTest_release_"))

(defn bind-falls-back-to-next-candidate? []
  (if (< (AddrTest.stream-families) 2)
    (do
      (IO.println "  skipped: localhost resolves to a single address family")
      true)
    (let [held (AddrTest.occupy-first)]
      (cond
        (= held -2)
          (do
            (IO.println "  skipped: the occupied address is rebindable here")
            true)
        (< held 0)
          (do
            (IO.println "  skipped: could not occupy the first candidate")
            true)
        (let-do [port (AddrTest.occupied-port held)
                 ok false]
          (match (TcpListener.bind "localhost" port)
            (Result.Success l) (do (set! ok true) (TcpListener.close l))
            (Result.Error _) ())
          (AddrTest.release held)
          ok)))))

(defn tcp-roundtrip []
  (match (TcpListener.bind "127.0.0.1" 0)
    ; port 0 = OS assigns
    (Result.Error _)
    false
    (Result.Success listener)
    (let [port (TcpListener.local-port &listener)]
      (match (TcpStream.connect "127.0.0.1" port)
        (Result.Error _) (do (TcpListener.close listener) false)
        (Result.Success client)
          (match (TcpListener.accept &listener)
            (Result.Error _)
              (do (TcpStream.close client) (TcpListener.close listener) false)
            (Result.Success conn)
              (do
                (ignore (TcpStream.send &client "ping"))
                (match (the (Result String String) (TcpStream.read &conn))
                  (Result.Success msg)
                    (let-do [ok (= &msg "ping")]
                      (ignore (TcpStream.send &conn "pong"))
                      (match (the (Result String String)
                                  (TcpStream.read &client))
                        (Result.Success reply)
                          (let-do [ok2 (and ok (= &reply "pong"))]
                            (TcpStream.close conn)
                            (TcpStream.close client)
                            (TcpListener.close listener)
                            ok2)
                        _
                          (do
                            (TcpStream.close conn)
                            (TcpStream.close client)
                            (TcpListener.close listener)
                            false)))
                  _
                    (do
                      (TcpStream.close conn)
                      (TcpStream.close client)
                      (TcpListener.close listener)
                      false))))))))

(defn tcp-peer-info []
  (match (TcpListener.bind "127.0.0.1" 0)
    (Result.Error _) false
    (Result.Success listener)
      (let [port (TcpListener.local-port &listener)]
        (match (TcpStream.connect "127.0.0.1" port)
          (Result.Error _) (do (TcpListener.close listener) false)
          (Result.Success client)
            (match (TcpListener.accept &listener)
              (Result.Error _)
                (do (TcpStream.close client) (TcpListener.close listener) false)
              (Result.Success conn)
                (let-do [addr (TcpStream.peer-address &conn)
                         ok (= &addr "127.0.0.1")]
                  (TcpStream.close conn)
                  (TcpStream.close client)
                  (TcpListener.close listener)
                  ok))))))

(defn nb-roundtrip []
  (match (TcpListener.bind "127.0.0.1" 0)
    (Result.Error _) false
    (Result.Success listener)
      (let [port (TcpListener.local-port &listener)]
        (match (TcpStream.connect "127.0.0.1" port)
          (Result.Error _) (do (TcpListener.close listener) false)
          (Result.Success client)
            (match (TcpListener.accept &listener)
              (Result.Error _)
                (do (TcpStream.close client) (TcpListener.close listener) false)
              (Result.Success conn)
                (let-do [buf (the (Array Byte) (Array.allocate 1024))
                         payload (the (Array Byte)
                                      [(Char.to-byte \h) (Char.to-byte \i)])
                         ok true]
                  (TcpStream.set-nonblocking &client)
                  ; nothing to read yet -> read-blocked sentinel
                  (match (TcpStream.read-append-nb &client &buf)
                    (Result.Success n)
                      (when (/= n TcpStream.read-blocked) (set! ok false))
                    (Result.Error _) (set! ok false))
                  (ignore (TcpStream.send &conn "ping"))
                  (System.sleep-micros 50000)
                  (match (TcpStream.read-append-nb &client &buf)
                    (Result.Success n) (when (/= n 4) (set! ok false))
                    (Result.Error _) (set! ok false))
                  (match (TcpStream.send-nb &client &payload 0)
                    (Result.Success n) (when (/= n 2) (set! ok false))
                    (Result.Error _) (set! ok false))
                  (TcpStream.close client)
                  (TcpStream.close conn)
                  (TcpListener.close listener)
                  ok))))))

(defn bufstream-test []
  (match (TcpListener.bind "127.0.0.1" 0)
    (Result.Error _) false
    (Result.Success listener)
      (let [port (TcpListener.local-port &listener)]
        (match (TcpStream.connect "127.0.0.1" port)
          (Result.Error _) (do (TcpListener.close listener) false)
          (Result.Success client)
            (match (TcpListener.accept &listener)
              (Result.Error _)
                (do (TcpStream.close client) (TcpListener.close listener) false)
              (Result.Success conn)
                (let-do [bs (TcpStream.buffered conn)]
                  (ignore (TcpStream.send &client "line one
line two
"))
                  (let-do [result (match (BufReader.read-line &bs)
                             (Result.Success line) (= &line "line one
")
                             _ false)]
                    (TcpStream.close client)
                    (BufReader.delete bs)
                    (TcpListener.close listener)
                    result)))))))

(deftest test
  (assert-true test
    (match (TcpListener.bind "127.0.0.1" 0)
      (Result.Success l) (do (TcpListener.close l) true)
      _ false)
    "TcpListener.bind succeeds on port 0")

  (assert-true test
    (match (TcpStream.connect "127.0.0.1" 1) (Result.Error _) true _ false)
    "TcpStream.connect fails when nothing listening")

  (assert-true test (tcp-roundtrip) "TCP roundtrip: send ping, receive pong")

  (assert-true test
    (tcp-peer-info)
    "peer-address returns 127.0.0.1 for loopback")

  (assert-true test
    (bufstream-test)
    "BufReader.read-line reads a line correctly")

  (assert-true test
    (nb-roundtrip)
    "non-blocking I/O: read-blocked, then read 4 bytes, then send 2 bytes")

  (assert-true test
    (bind-falls-back-to-next-candidate?)
    "bind tries the next candidate when the first address is taken"))
